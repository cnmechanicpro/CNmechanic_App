{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cnmechanic-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [{"name":"SEARCH_RATE_LIMITER","namespace_id":"1001","simple":{"limit":60,"period":60}},{"name":"MARKETPLACE_RATE_LIMITER","namespace_id":"1004","simple":{"limit":30,"period":60}}],
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173"
  },
  "env": {
    "preview": {
      "name": "cnmechanic-api-preview",
      "ratelimits": [{"name":"SEARCH_RATE_LIMITER","namespace_id":"1002","simple":{"limit":60,"period":60}},{"name":"MARKETPLACE_RATE_LIMITER","namespace_id":"1005","simple":{"limit":30,"period":60}}],
      "vars": {
        "ENVIRONMENT": "preview",
        "ALLOWED_ORIGINS": "https://preview.cnmechanic.com"
      }
    },
    "production": {
      "name": "cnmechanic-api",
      "ratelimits": [{"name":"SEARCH_RATE_LIMITER","namespace_id":"1003","simple":{"limit":60,"period":60}},{"name":"MARKETPLACE_RATE_LIMITER","namespace_id":"1006","simple":{"limit":30,"period":60}}],
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://www.cnmechanic.com",
        "SUPABASE_URL": "https://fzvqeeydbblcaxjrfwxl.supabase.co"
      },
      "routes": [
        {
          "pattern": "api.cnmechanic.com",
          "custom_domain": true
        }
      ]
    }
  }
}
